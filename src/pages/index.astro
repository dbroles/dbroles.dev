---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AppShowcase from '../components/AppShowcase.astro';
import ValueProposition from '../components/ValueProposition.astro';
import RoleAttributesGuide from '../components/RoleAttributesGuide.astro';
import SecurityPillars from '../components/SecurityPillars.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Roadmap from '../components/Roadmap.astro';
import SpeakerBio from '../components/SpeakerBio.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="User Manager for PostgreSQL | dbroles.dev - Free Database Role & User Management"
  description="The free, privacy-first, cross-platform database user management app. Delegate user onboarding to the helpdesk safely without sharing SUPERUSER privileges. Available on macOS, Windows, Linux, iOS & Android."
>
  <Navbar />
  <main>
    <Hero />
    <AppShowcase />
    <ValueProposition />
    <RoleAttributesGuide />
    <SecurityPillars />
    <DownloadSection />
    <Roadmap />
    <SpeakerBio />
  </main>
  <Footer />
</Layout>

