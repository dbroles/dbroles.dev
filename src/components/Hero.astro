---
// src/components/Hero.astro
---

<section id="overview" class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <!-- Announcement Badge -->
    <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-[#1A2216] border border-[#2F3E22] mb-8 shadow-sm hover:border-[#88AA00]/50 transition-colors">
      <span class="flex h-2 w-2 rounded-full bg-[#88AA00] animate-pulse"></span>
      <span class="text-xs font-semibold text-gray-300">
        Free Software &bull; Zero Tracking &bull; Direct Database Connection
      </span>
      <span class="text-xs text-[#88AA00] font-bold">v1.0 Live &rarr;</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-5xl mx-auto leading-[1.12]">
      Effortless Database User Management. <br />
      <span class="bg-gradient-to-r from-[#88AA00] via-[#A8D400] to-[#E2F78A] bg-clip-text text-transparent">
        Safe Enough to Delegate.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
      Your job as a DBA is granting privileges to groups. The helpdesk's job is assigning users into those groups. 
      Stop wasting hours on onboarding and department-swap tickets — delegate user management safely <strong class="text-white font-semibold underline decoration-[#88AA00] decoration-2 underline-offset-4">without ever handing out SUPERUSER</strong>.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#downloads"
        class="inline-flex items-center space-x-2.5 px-7 py-3.5 text-base font-bold text-black bg-[#88AA00] hover:bg-[#9CCE00] active:scale-95 rounded-xl shadow-brand-glow hover:shadow-brand-glow-lg transition-all duration-200"
      >
        <svg class="w-5 h-5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download Free App</span>
      </a>

      <a
        href="#screenshots"
        class="inline-flex items-center space-x-2 px-6 py-3.5 text-base font-semibold text-white bg-[#141A10] hover:bg-[#1C2517] border border-[#2B3921] rounded-xl transition-all duration-200"
      >
        <span>Explore Interface</span>
        <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="10 8 16 12 10 16 10 8"></polygon>
        </svg>
      </a>

      <a
        href="https://github.com/dbroles/postgresql"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center space-x-2 px-5 py-3.5 text-base font-semibold text-gray-300 hover:text-white bg-[#10140D] hover:bg-[#161D12] border border-[#232D1C] rounded-xl transition-all"
      >
        <svg class="w-5 h-5 text-gray-400 group-hover:text-white" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>Source Code</span>
      </a>
    </div>

    <!-- Trust / Capability Highlights Badges -->
    <div class="mt-14 pt-8 border-t border-[#222C1B] grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-4xl mx-auto">
      <div class="flex flex-col items-center p-3 rounded-lg bg-[#11160E]/60 border border-[#202919]">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-medium">Platforms</span>
        <span class="text-sm font-semibold text-white mt-1">macOS, Win, Linux, iOS, Android</span>
      </div>
      <div class="flex flex-col items-center p-3 rounded-lg bg-[#11160E]/60 border border-[#202919]">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-medium">PostgreSQL Versions</span>
        <span class="text-sm font-semibold text-[#88AA00] mt-1">v14, v15, v16 &amp; v17</span>
      </div>
      <div class="flex flex-col items-center p-3 rounded-lg bg-[#11160E]/60 border border-[#202919]">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-medium">Required Privilege</span>
        <span class="text-sm font-semibold text-white mt-1">CREATEROLE (No Superuser)</span>
      </div>
      <div class="flex flex-col items-center p-3 rounded-lg bg-[#11160E]/60 border border-[#202919]">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-medium">Privacy &amp; Price</span>
        <span class="text-sm font-semibold text-[#88AA00] mt-1">100% Free &bull; No Tracking</span>
      </div>
    </div>

  </div>
</section>

