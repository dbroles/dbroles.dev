---
// src/components/Navbar.astro
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#0A0D08]/85 border-b border-[#242F1E]/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo & Brand -->
      <a href="#" class="flex items-center space-x-3 group">
        <div class="relative w-10 h-10 rounded-xl overflow-hidden p-0.5 bg-gradient-to-br from-[#88AA00] to-[#556B2F] shadow-sm transition-transform duration-200 group-hover:scale-105">
          <img src="/images/app-icon.png" alt="dbroles.dev Logo" class="w-full h-full object-contain rounded-[10px] bg-[#0E130B]" />
          <img src="/images/app-icon-dbroles.png" alt="dbroles.dev Logo" class="w-full h-full object-contain rounded-[10px] bg-[#0E130B]" />
        </div>
        <div class="flex flex-col">
          <div class="flex items-center space-x-2">
            <span class="text-xl font-bold tracking-tight text-white group-hover:text-[#88AA00] transition-colors">
              dbroles<span class="text-[#88AA00]">.dev</span>
            </span>
            <span class="px-2 py-0.5 text-[11px] font-semibold tracking-wide uppercase bg-[#88AA00]/15 text-[#88AA00] border border-[#88AA00]/30 rounded-full">
              PostgreSQL
            </span>
          </div>
          <span class="text-[11px] text-gray-400 font-medium">User Manager App Suite</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-gray-300">
        <a href="#overview" class="hover:text-[#88AA00] transition-colors">Overview</a>
        <a href="#delegation" class="hover:text-[#88AA00] transition-colors">How It Works</a>
        <a href="#screenshots" class="hover:text-[#88AA00] transition-colors">Screenshots</a>
        <a href="#roles" class="hover:text-[#88AA00] transition-colors">Role Model</a>
        <a href="#security" class="hover:text-[#88AA00] transition-colors">Security</a>
        <a href="#downloads" class="hover:text-[#88AA00] transition-colors">Downloads</a>
        <a href="#roadmap" class="hover:text-[#88AA00] transition-colors">Roadmap</a>
        <a href="#about" class="hover:text-[#88AA00] transition-colors">About</a>
      </nav>

      <!-- Right CTAs -->
      <div class="flex items-center space-x-3">
        <!-- Buy Me A Coffee link -->
        <a 
          href="https://buymeacoffee.com/dbroles" 
          target="_blank" 
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center space-x-1.5 px-3 py-1.5 text-xs font-semibold text-amber-200 bg-amber-950/40 hover:bg-amber-900/60 border border-amber-600/40 rounded-lg transition-all"
          title="Support independent open-source development"
        >
          <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
          <span>Buy a coffee</span>
        </a>

        <!-- GitHub Repo -->
        <a 
          href="https://github.com/dbroles/postgresql" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-1.5 px-3 py-1.5 text-xs font-semibold text-gray-200 bg-[#141A10] hover:bg-[#1E2618] border border-[#2B3821] rounded-lg transition-all"
        >
          <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          <span class="hidden sm:inline">GitHub</span>
        </a>

        <!-- Download CTA button -->
        <a 
          href="#downloads" 
          class="inline-flex items-center space-x-1.5 px-4 py-1.5 text-xs font-bold text-black bg-[#88AA00] hover:bg-[#99BE00] active:scale-95 rounded-lg shadow-sm transition-all"
        >
          <svg class="w-4 h-4 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Get Free</span>
        </a>
      </div>

    </div>
  </div>
</header>

