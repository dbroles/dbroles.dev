---
// src/components/AppShowcase.astro
---

<section id="screenshots" class="py-16 md:py-24 bg-[#080B07] border-y border-[#202A1A] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h2 class="text-xs font-bold uppercase tracking-widest text-[#88AA00]">Native Everywhere</h2>
      <p class="mt-2 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        One Consistent Experience on Every Device
      </p>
      <p class="mt-3 text-base text-gray-400">
        Engineered with Flutter for high-performance, pixel-perfect native rendering across desktop and mobile. 
        Whether you're at your dual-monitor desk or handling an urgent permission request on your phone.
      </p>
    </div>

    <!-- Interactive Platform Switcher -->
    <div class="flex justify-center mb-8">
      <div class="inline-flex p-1 rounded-xl bg-[#141A10] border border-[#27341F] shadow-inner" id="platform-tabs" role="tablist">
        <button
          type="button"
          data-target="macos"
          class="platform-tab active px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg flex items-center space-x-2 transition-all bg-[#88AA00] text-black shadow-sm"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 1.01-2.87-1 .04-2.18.67-2.81 1.42-.56.64-1.06 1.71-.97 2.76 1.13.09 2.16-.56 2.77-1.31z"/>
          </svg>
          <span>macOS</span>
        </button>

        <button
          type="button"
          data-target="windows"
          class="platform-tab px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg flex items-center space-x-2 transition-all text-gray-300 hover:text-white"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
          </svg>
          <span>Windows</span>
        </button>

        <button
          type="button"
          data-target="linux"
          class="platform-tab px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg flex items-center space-x-2 transition-all text-gray-300 hover:text-white"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2a4 4 0 0 0-4 4c0 1.5.8 2.8 2 3.5-.5 1-1.3 2.1-2.2 3.1-1.7 1.9-3.8 3.5-3.8 6.4 0 1.1.9 2 2 2h12a2 2 0 0 0 2-2c0-2.9-2.1-4.5-3.8-6.4-.9-1-1.7-2.1-2.2-3.1 1.2-.7 2-2 2-3.5a4 4 0 0 0-4-4z"/>
          </svg>
          <span>Linux</span>
        </button>

        <button
          type="button"
          data-target="iphone"
          class="platform-tab px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg flex items-center space-x-2 transition-all text-gray-300 hover:text-white"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12.01" y2="18"></line>
          </svg>
          <span>iOS / Android</span>
        </button>
      </div>
    </div>

    <!-- Screenshot Display Container -->
    <div class="relative max-w-5xl mx-auto">
      
      <!-- macOS Display -->
      <div id="view-macos" class="platform-view transition-opacity duration-300">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-[#2D3C23] bg-[#12180F] p-2 sm:p-4">
          <div class="flex items-center justify-between px-3 py-2 border-b border-[#24301D] mb-3 text-xs text-gray-400">
            <span class="flex items-center space-x-1.5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F56] inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-[#FFBD2E] inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-[#27C93F] inline-block"></span>
              <span class="ml-2 font-mono font-medium text-gray-300">User Manager for PostgreSQL &mdash; macOS</span>
            </span>
            <span class="text-[11px] font-mono text-[#88AA00]">SSL: ACTIVE</span>
          </div>
          <img
            src="/images/screen-macos.png"
            alt="User Manager for PostgreSQL running on macOS"
            class="w-full h-auto rounded-xl shadow-lg border border-[#24301D] object-contain mx-auto"
            loading="eager"
          />
        </div>
      </div>

      <!-- Windows Display -->
      <div id="view-windows" class="platform-view hidden transition-opacity duration-300">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-[#2D3C23] bg-[#12180F] p-2 sm:p-4">
          <div class="flex items-center justify-between px-3 py-2 border-b border-[#24301D] mb-3 text-xs text-gray-400">
            <span class="flex items-center space-x-2">
              <span class="font-mono font-medium text-gray-300">User Manager for PostgreSQL &mdash; Windows 11</span>
            </span>
            <span class="text-[11px] font-mono text-[#88AA00]">SSL: ACTIVE</span>
          </div>
          <img
            src="/images/screen-windows.png"
            alt="User Manager for PostgreSQL running on Windows"
            class="w-full h-auto rounded-xl shadow-lg border border-[#24301D] object-contain mx-auto"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Linux Display -->
      <div id="view-linux" class="platform-view hidden transition-opacity duration-300">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-[#2D3C23] bg-[#12180F] p-2 sm:p-4">
          <div class="flex items-center justify-between px-3 py-2 border-b border-[#24301D] mb-3 text-xs text-gray-400">
            <span class="flex items-center space-x-2">
              <span class="font-mono font-medium text-gray-300">User Manager for PostgreSQL &mdash; Linux Desktop</span>
            </span>
            <span class="text-[11px] font-mono text-[#88AA00]">SSL: ACTIVE</span>
          </div>
          <img
            src="/images/screen-linux.png"
            alt="User Manager for PostgreSQL running on Linux"
            class="w-full h-auto rounded-xl shadow-lg border border-[#24301D] object-contain mx-auto"
            loading="lazy"
          />
        </div>
      </div>

      <!-- iPhone / Mobile Display -->
      <div id="view-iphone" class="platform-view hidden transition-opacity duration-300">
        <div class="relative max-w-sm mx-auto rounded-[3rem] p-4 bg-[#141B10] border-4 border-[#2B3921] shadow-2xl">
          <div class="text-center pb-2 text-xs font-mono text-gray-400">iOS &bull; iPadOS &bull; Android</div>
          <div class="relative rounded-[2.2rem] overflow-hidden border border-[#202A19]">
            <img
              src="/images/screen-iphone.png"
              alt="User Manager for PostgreSQL running on iPhone"
              class="w-full h-auto object-contain mx-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>

    </div>

    <!-- UI Walkthrough Callout Grid -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <div class="p-5 rounded-xl bg-[#12180F] border border-[#232E1C] hover:border-[#88AA00]/40 transition-colors">
        <div class="w-8 h-8 rounded-lg bg-[#88AA00]/15 flex items-center justify-center text-[#88AA00] font-bold text-sm mb-3">1</div>
        <h3 class="text-base font-bold text-white">Left Pane: User Directory</h3>
        <p class="mt-1 text-sm text-gray-400 leading-relaxed">
          Filter and select any database login user (like <code class="text-[#88AA00]">alice</code>, <code class="text-[#88AA00]">bob</code>, or <code class="text-[#88AA00]">karen</code>). Quickly create new users with the floating action button.
        </p>
      </div>

      <div class="p-5 rounded-xl bg-[#12180F] border border-[#232E1C] hover:border-[#88AA00]/40 transition-colors">
        <div class="w-8 h-8 rounded-lg bg-[#88AA00]/15 flex items-center justify-center text-[#88AA00] font-bold text-sm mb-3">2</div>
        <h3 class="text-base font-bold text-white">Role Attribute Badges</h3>
        <p class="mt-1 text-sm text-gray-400 leading-relaxed">
          Instantly inspect role attributes at a glance: <strong>Superuser</strong>, <strong>Inherit</strong>, <strong>CreateRole</strong>, <strong>CreateDB</strong>, <strong>Login</strong>, <strong>Replication</strong>, and <strong>BypassRLS</strong>. Green means active; grey means inactive.
        </p>
      </div>

      <div class="p-5 rounded-xl bg-[#12180F] border border-[#232E1C] hover:border-[#88AA00]/40 transition-colors">
        <div class="w-8 h-8 rounded-lg bg-[#88AA00]/15 flex items-center justify-center text-[#88AA00] font-bold text-sm mb-3">3</div>
        <h3 class="text-base font-bold text-white">One-Click Group Grants</h3>
        <p class="mt-1 text-sm text-gray-400 leading-relaxed">
          Assign or revoke role memberships with instant checkboxes. Filter between <em>All</em>, <em>Assigned</em>, and <em>Available</em> groups with helpful descriptions.
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  function setupPlatformSwitcher() {
    const tabs = document.querySelectorAll('.platform-tab');
    const views = document.querySelectorAll('.platform-view');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        if (!target) return;

        // Reset tabs
        tabs.forEach((t) => {
          t.classList.remove('bg-[#88AA00]', 'text-black', 'shadow-sm', 'active');
          t.classList.add('text-gray-300');
        });

        // Activate current tab
        tab.classList.add('bg-[#88AA00]', 'text-black', 'shadow-sm', 'active');
        tab.classList.remove('text-gray-300');

        // Toggle views
        views.forEach((v) => {
          v.classList.add('hidden');
        });

        const activeView = document.getElementById(`view-${target}`);
        if (activeView) {
          activeView.classList.remove('hidden');
        }
      });
    });
  }

  // Run on page load & Astro client navigation
  setupPlatformSwitcher();
  document.addEventListener('astro:page-load', setupPlatformSwitcher);
</script>

