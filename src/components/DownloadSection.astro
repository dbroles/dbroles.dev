---
// src/components/DownloadSection.astro
---

<section id="downloads" class="py-16 md:py-24 bg-[#080B07] border-t border-[#202A1A] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-semibold text-[#88AA00] bg-[#88AA00]/10 border border-[#88AA00]/25 mb-4">
        <span>100% Free &bull; Multi-Platform</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Download User Manager for PostgreSQL
      </h2>
      <p class="mt-4 text-base sm:text-lg text-gray-300 leading-relaxed">
        Free forever. No account required. Download for desktop, grab it on mobile, or install from your favorite app store.
      </p>
    </div>

    <!-- Download Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      
      <!-- Card 1: macOS -->
      <div class="p-6 rounded-2xl bg-[#12180F] border border-[#232F1C] hover:border-[#88AA00]/50 transition-all flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-[#1A2215] border border-[#2C3B20] flex items-center justify-center text-white group-hover:text-[#88AA00] transition-colors">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 1.01-2.87-1 .04-2.18.67-2.81 1.42-.56.64-1.06 1.71-.97 2.76 1.13.09 2.16-.56 2.77-1.31z"/>
              </svg>
            </div>
            <span class="text-xs font-mono text-[#88AA00] bg-[#88AA00]/10 px-2.5 py-1 rounded-full border border-[#88AA00]/25">
              Apple Silicon &amp; Intel
            </span>
          </div>
          <h3 class="text-xl font-bold text-white">macOS</h3>
          <p class="mt-2 text-sm text-gray-400">
            Universal binary for macOS 12 Monterey or newer. Integrated with Apple Keychain.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[#1C2616] space-y-2">
          <a
            href="https://github.com/dbroles/postgresql/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center space-x-2 py-2.5 px-4 text-xs font-bold text-black bg-[#88AA00] hover:bg-[#9CCE00] active:scale-95 rounded-lg transition-all"
          >
            <span>Download .dmg</span>
          </a>
          <div class="flex items-center justify-between text-[11px] text-gray-400 px-1 pt-1">
            <span>Also on Mac App Store</span>
            <span class="font-mono text-gray-400">v1.0 &bull; Free</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Windows -->
      <div class="p-6 rounded-2xl bg-[#12180F] border border-[#232F1C] hover:border-[#88AA00]/50 transition-all flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-[#1A2215] border border-[#2C3B20] flex items-center justify-center text-white group-hover:text-[#88AA00] transition-colors">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
              </svg>
            </div>
            <span class="text-xs font-mono text-[#88AA00] bg-[#88AA00]/10 px-2.5 py-1 rounded-full border border-[#88AA00]/25">
              Win 10 &amp; 11
            </span>
          </div>
          <h3 class="text-xl font-bold text-white">Windows</h3>
          <p class="mt-2 text-sm text-gray-400">
            Native Windows app utilizing Windows Credential Manager for encrypted secrets.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[#1C2616] space-y-2">
          <a
            href="https://github.com/dbroles/postgresql/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center space-x-2 py-2.5 px-4 text-xs font-bold text-black bg-[#88AA00] hover:bg-[#9CCE00] active:scale-95 rounded-lg transition-all"
          >
            <span>Download .msi / .exe</span>
          </a>
          <div class="flex items-center justify-between text-[11px] text-gray-400 px-1 pt-1">
            <span>Also on Microsoft Store</span>
            <span class="font-mono text-gray-400">v1.0 &bull; Free</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Linux -->
      <div class="p-6 rounded-2xl bg-[#12180F] border border-[#232F1C] hover:border-[#88AA00]/50 transition-all flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-[#1A2215] border border-[#2C3B20] flex items-center justify-center text-white group-hover:text-[#88AA00] transition-colors">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2a4 4 0 0 0-4 4c0 1.5.8 2.8 2 3.5-.5 1-1.3 2.1-2.2 3.1-1.7 1.9-3.8 3.5-3.8 6.4 0 1.1.9 2 2 2h12a2 2 0 0 0 2-2c0-2.9-2.1-4.5-3.8-6.4-.9-1-1.7-2.1-2.2-3.1 1.2-.7 2-2 2-3.5a4 4 0 0 0-4-4z"/>
              </svg>
            </div>
            <span class="text-xs font-mono text-[#88AA00] bg-[#88AA00]/10 px-2.5 py-1 rounded-full border border-[#88AA00]/25">
              AppImage / DEB / Arch
            </span>
          </div>
          <h3 class="text-xl font-bold text-white">Linux</h3>
          <p class="mt-2 text-sm text-gray-400">
            Debian, Ubuntu, Fedora, Arch. Compatible with Linux Secret Service and GNOME Keyring.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[#1C2616] space-y-2">
          <a
            href="https://github.com/dbroles/postgresql/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center space-x-2 py-2.5 px-4 text-xs font-bold text-black bg-[#88AA00] hover:bg-[#9CCE00] active:scale-95 rounded-lg transition-all"
          >
            <span>Download AppImage / .deb</span>
          </a>
          <div class="flex items-center justify-between text-[11px] text-gray-400 px-1 pt-1">
            <span>Also on Flathub / Snap</span>
            <span class="font-mono text-gray-400">v1.0 &bull; Free</span>
          </div>
        </div>
      </div>

      <!-- Card 4: iOS & iPadOS -->
      <div class="p-6 rounded-2xl bg-[#12180F] border border-[#232F1C] hover:border-[#88AA00]/50 transition-all flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-[#1A2215] border border-[#2C3B20] flex items-center justify-center text-white group-hover:text-[#88AA00] transition-colors">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                <line x1="12" y1="18" x2="12.01" y2="18"></line>
              </svg>
            </div>
            <span class="text-xs font-mono text-[#88AA00] bg-[#88AA00]/10 px-2.5 py-1 rounded-full border border-[#88AA00]/25">
              Apple App Store
            </span>
          </div>
          <h3 class="text-xl font-bold text-white">iOS &amp; iPadOS</h3>
          <p class="mt-2 text-sm text-gray-400">
            Handle emergency role grants or offboardings directly from your iPhone or iPad with Touch ID / Face ID Keychain.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[#1C2616]">
          <a
            href="https://apps.apple.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center space-x-2 py-2.5 px-4 text-xs font-bold text-white bg-[#1C2517] hover:bg-[#25321E] border border-[#344426] rounded-lg transition-all"
          >
            <span>Apple App Store (Free)</span>
          </a>
        </div>
      </div>

      <!-- Card 5: Android -->
      <div class="p-6 rounded-2xl bg-[#12180F] border border-[#232F1C] hover:border-[#88AA00]/50 transition-all flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-[#1A2215] border border-[#2C3B20] flex items-center justify-center text-white group-hover:text-[#88AA00] transition-colors">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4116 13.8533 8.0818 12 8.0818c-1.8532 0-3.5901.3298-5.1368.8679L4.8409 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
              </svg>
            </div>
            <span class="text-xs font-mono text-[#88AA00] bg-[#88AA00]/10 px-2.5 py-1 rounded-full border border-[#88AA00]/25">
              Google Play &bull; APK
            </span>
          </div>
          <h3 class="text-xl font-bold text-white">Android</h3>
          <p class="mt-2 text-sm text-gray-400">
            Available on Google Play and direct sideload APK. Backed by Android KeyStore hardware security.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[#1C2616]">
          <a
            href="https://play.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center space-x-2 py-2.5 px-4 text-xs font-bold text-white bg-[#1C2517] hover:bg-[#25321E] border border-[#344426] rounded-lg transition-all"
          >
            <span>Google Play Store (Free)</span>
          </a>
        </div>
      </div>

      <!-- Card 6: GitHub Releases -->
      <div class="p-6 rounded-2xl bg-[#12180F] border border-[#232F1C] hover:border-[#88AA00]/50 transition-all flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-[#1A2215] border border-[#2C3B20] flex items-center justify-center text-white group-hover:text-[#88AA00] transition-colors">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
            </div>
            <span class="text-xs font-mono text-[#88AA00] bg-[#88AA00]/10 px-2.5 py-1 rounded-full border border-[#88AA00]/25">
              Open Source
            </span>
          </div>
          <h3 class="text-xl font-bold text-white">GitHub Releases</h3>
          <p class="mt-2 text-sm text-gray-400">
            Checksums, source code, release changelogs, and direct archive downloads for all platforms.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[#1C2616]">
          <a
            href="https://github.com/dbroles/postgresql/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center space-x-2 py-2.5 px-4 text-xs font-bold text-white bg-[#1C2517] hover:bg-[#25321E] border border-[#344426] rounded-lg transition-all"
          >
            <span>View All GitHub Releases</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Running from Source Snippet -->
    <div class="max-w-4xl mx-auto rounded-2xl bg-[#11160E] border border-[#232F1C] p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
        <div>
          <h3 class="text-lg font-bold text-white flex items-center space-x-2">
            <svg class="w-5 h-5 text-[#88AA00]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
            <span>Prefer Compiling from Source?</span>
          </h3>
          <p class="text-xs text-gray-400 mt-1">Built with Flutter. Fast setup on any machine with Flutter SDK installed.</p>
        </div>
        <a
          href="https://github.com/dbroles/postgresql"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 sm:mt-0 text-xs font-semibold text-[#88AA00] hover:underline"
        >
          Inspect on GitHub &rarr;
        </a>
      </div>

      <div class="relative rounded-xl bg-[#090C07] p-4 font-mono text-xs sm:text-sm text-gray-200 border border-[#1E2818] overflow-x-auto">
        <pre><span class="text-gray-400"># 1. Clone the repository</span>
<span class="text-[#88AA00]">git clone</span> git@github.com:dbroles/postgresql.git
<span class="text-[#88AA00]">cd</span> postgresql

<span class="text-gray-400"># 2. Fetch packages & run test suite</span>
<span class="text-[#88AA00]">flutter pub get</span>
<span class="text-[#88AA00]">flutter test</span>

<span class="text-gray-400"># 3. Launch on your target platform</span>
<span class="text-[#88AA00]">flutter run</span> -d macos   <span class="text-gray-400"># or -d windows, -d linux</span></pre>
      </div>
    </div>

  </div>
</section>

