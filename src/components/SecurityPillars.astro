---
// src/components/SecurityPillars.astro
---

<section id="security" class="py-16 md:py-24 bg-[#0A0D08] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-semibold text-[#88AA00] bg-[#88AA00]/10 border border-[#88AA00]/25 mb-4">
        <span>Security &bull; Privacy &bull; Trust</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Zero Tracking. Zero Ads. <br />
        <span class="text-[#88AA00]">OS-Grade Credential Protection.</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-gray-300 leading-relaxed">
        Database credentials are your organization's crown jewels. User Manager is built with a strict local-first architecture: no cloud relays, no telemetry, and hardware-backed credential storage.
      </p>
    </div>

    <!-- 4 Security Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Pillar 1: No Superuser -->
      <div class="p-6 rounded-2xl bg-[#11160E] border border-[#232F1C] hover:border-[#88AA00]/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[#88AA00]/10 border border-[#88AA00]/30 flex items-center justify-center text-[#88AA00] mb-5">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white">No Superuser Required</h3>
          <p class="mt-2 text-sm text-gray-400 leading-relaxed">
            Never hand out <code class="text-[#88AA00]">SUPERUSER</code> to staff. User Manager only requires a role with standard <code class="text-gray-200">CREATEROLE</code> privileges, ensuring the principle of least privilege is preserved.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#1C2616] text-[11px] font-mono text-[#88AA00]">
          ROLE: CREATEROLE ONLY
        </div>
      </div>

      <!-- Pillar 2: OS Keyring -->
      <div class="p-6 rounded-2xl bg-[#11160E] border border-[#232F1C] hover:border-[#88AA00]/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[#88AA00]/10 border border-[#88AA00]/30 flex items-center justify-center text-[#88AA00] mb-5">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white">OS-Level Vaults</h3>
          <p class="mt-2 text-sm text-gray-400 leading-relaxed">
            Passwords are never written in plain text files. They are encrypted using Apple Keychain, Windows Credential Manager, Linux Secret Service / Keyring, or Android KeyStore.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#1C2616] text-[11px] font-mono text-gray-400">
          flutter_secure_storage
        </div>
      </div>

      <!-- Pillar 3: SSL / TLS -->
      <div class="p-6 rounded-2xl bg-[#11160E] border border-[#232F1C] hover:border-[#88AA00]/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[#88AA00]/10 border border-[#88AA00]/30 flex items-center justify-center text-[#88AA00] mb-5">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white">Mandatory TLS / SSL</h3>
          <p class="mt-2 text-sm text-gray-400 leading-relaxed">
            Secure client-to-server communication with enforced encryption (<code class="text-gray-200">sslMode = require</code>). Includes live connection security indicators directly in the status bar.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#1C2616] text-[11px] font-mono text-[#88AA00]">
          ENCRYPTED TRANSIT
        </div>
      </div>

      <!-- Pillar 4: Zero Tracking -->
      <div class="p-6 rounded-2xl bg-[#11160E] border border-[#232F1C] hover:border-[#88AA00]/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[#88AA00]/10 border border-[#88AA00]/30 flex items-center justify-center text-[#88AA00] mb-5">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
              <line x1="1" y1="1" x2="23" y2="23"></line>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white">Zero Tracking &amp; No Ads</h3>
          <p class="mt-2 text-sm text-gray-400 leading-relaxed">
            No telemetry, no tracking pixels, no third-party SDKs, and no advertisements. The software connects only directly to the database host you specify. 100% free forever.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#1C2616] text-[11px] font-mono text-[#88AA00]">
          0 CLOUD PROXIES
        </div>
      </div>

    </div>

  </div>
</section>

